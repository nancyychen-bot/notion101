# Database
DATABASE_URL=          # Neon Postgres connection string (injected by Vercel integration)

# Luma
LUMA_API_KEY=          # Luma public API key (x-luma-api-key header)
LUMA_WEBHOOK_SECRET=   # Optional — HMAC secret for verifying Luma webhook payloads

# Notion
NOTION_TOKEN=                    # Notion integration token
NOTION_GUESTS_DATA_SOURCE_ID=    # Data-source ID for the Notion guests database (API v2025-09-03+)
NOTION_GUESTS_DB_ID=             # Optional — Notion DB ID used for generating page links
NOTION_WEBHOOK_SECRET=           # Optional — shared secret for verifying Notion webhook payloads
NOTION_FEEDBACK_DB_ID=           # Optional — override the shared feedback DB id (default pinned in code)

# Email (Resend)
RESEND_API_KEY=        # Resend API key
COMMS_FROM=            # Sender address, e.g. "Notion 101 <noreply@notioncommunity.com>"
COMMS_REPLY_TO=        # Optional — reply-to address
COMMS_ENABLED=         # Optional kill-switch; set to "false" to disable all outbound email (default: true)

# App
APP_BASE_URL=          # Public base URL of the app, e.g. https://notion101.vercel.app (default: http://localhost:3000)
CRON_SECRET=           # Secret used to authenticate cron route requests (header or bearer)
SURVEY_URL=            # Fixed post-event survey link
FREE_TRIAL_URL=        # Notion free-trial CTA URL used in reminder emails (default: https://www.notion.so/product)

# Dashboard
DASHBOARD_PASSWORD=    # Password for the password-protected dashboard
SESSION_SECRET=        # Secret for signing the session cookie
